# Variáveis de ambiente do SARC
# Copie este arquivo para .env e preencha os valores de produção
# O arquivo .env NUNCA deve ser commitado no Git

# Senha do PostgreSQL (padrão 'sarc' apenas para desenvolvimento local)
DB_PASSWORD=sarc

# Senha do usuário admin do Keycloak (padrão 'admin' apenas para desenvolvimento local)
KEYCLOAK_ADMIN_PASSWORD=admin

# Origem permitida no CORS do API Gateway (padrão localhost:3000)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Probabilidade de sampling do OpenTelemetry (1.0 = 100% em dev)
TRACING_PROBABILITY=1.0
